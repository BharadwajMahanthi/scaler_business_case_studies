[flake8]
max-line-length = 100
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    env,
    .env,
    app/random_forest_model.pkl,
    app/scaler.pkl
ignore =
    E203, # Whitespace before ':'
    W503  # Line break before binary operator
per-file-ignores =
    __init__.py: F401
